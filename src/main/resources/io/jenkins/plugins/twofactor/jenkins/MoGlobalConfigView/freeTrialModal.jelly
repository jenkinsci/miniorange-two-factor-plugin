<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler">

    <!-- Primary discovery: top enterprise banner (config pages only) -->
    <div id="mo-upsell-banner" class="mo-upsell-banner" role="region" aria-label="Premium Edition capabilities">
        <div class="mo-upsell-banner__accent" aria-hidden="true"/>
        <div class="mo-upsell-banner__icon" aria-hidden="true">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 2L4 6v6c0 5.25 3.4 10.15 8 11.35C16.6 22.15 20 17.25 20 12V6l-8-4z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <div class="mo-upsell-banner__body">
            <span class="mo-upsell-badge">Premium Edition</span>
            <h2 class="mo-upsell-banner__title">Harden Jenkins 2FA for production teams</h2>
            <p class="mo-upsell-banner__subtitle">
                Protect REST API access, enforce 2FA by group, and add TOTP, Duo, and SMS authentication methods.
                <strong>Try all Premium features for 30 days</strong> — evaluate in this controller.
            </p>
        </div>
        <div class="mo-upsell-banner__actions">
            <button type="button" class="mo-btn mo-btn--primary" id="modal-open-button">View Premium capabilities</button>
            <button type="button" class="mo-btn mo-btn--secondary mo-banner-compare-btn">Compare editions</button>
        </div>
    </div>

    <st:adjunct includes="io.jenkins.plugins.twofactor.jenkins.MoGlobalConfigView.premiumDiscoveryModals"/>

</j:jelly>
